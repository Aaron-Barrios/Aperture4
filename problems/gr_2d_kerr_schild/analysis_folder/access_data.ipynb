    "def jI_model(nu, n, B, theta_e, theta_B, fit_e, fit_B):\n",
    "    A0, d, c, gamm = fit_e\n",
    "    slope, b = fit_B\n",
    "\n",
    "    F_thetaB = theta_B**slope * 10**b\n",
    "    F_thetae = A0*theta_e**d * np.exp(-c/theta_e**gamm)\n",
    "    return F_thetaB*F_thetae"
   ]
