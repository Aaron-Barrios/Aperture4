    "        if get_pos:\n",
    "            return tuple(np.array([o[i] for o in out]) for i in range(4))\n",
    "        return tuple(np.array([o[i] for o in out]) for i in range(2))\n",
    "\n",
    "    # Both arrays\n",
    "    n_te, n_tb = len(theta_e_arr), len(theta_B_arr)\n",
