    "    nu_c = nuc_prime(B, theta_e, theta_B)\n",
    "    x = nu/nu_c\n",
    "    top = n*q_e*q_e * nu * I_Islow(x, theta_e)\n",
    "    bot = np.sqrt(3.)*kv(2., 1/theta_e)*c * theta_e\n",
    "    return top/bot"
